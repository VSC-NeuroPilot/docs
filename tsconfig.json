{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*",
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@assets/*": [
        "./src/assets/*"
      ],
      "@static/*": [
        "./public/*"
      ],
      "@consts/*": [
        "./consts/*"
      ],
      "@templates/*": [
        "./src/templates/*"
      ],
      "_starlight-sidebar-schemas": [
        "./node_modules/@astrojs/starlight/schemas/sidebar"
      ]
    }
  }
}